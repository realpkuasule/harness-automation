{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/realpkuasule/harness-automation/main/docs/api/harness-policy-v2.schema.json",
  "title": "Harness Engineering Policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "sources",
    "agents",
    "policies"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "phase", "stacks"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": ["design-approved", "development", "maintenance"]
        },
        "stacks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "deliveryProfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["worktree-delivery"]
          }
        },
        "domainProfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["game-development"]
          }
        },
        "qualityProfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["eval-driven-development"]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "sha256", "approved"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": ["prd", "design", "research", "eval", "existing-policy"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approved": {
            "type": "boolean"
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portableInstructionFile", "adapters"],
      "properties": {
        "portableInstructionFile": {
          "const": "AGENTS.md"
        },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "capabilities"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "root-instructions",
                    "scoped-instructions",
                    "instruction-imports",
                    "session-hooks",
                    "mcp",
                    "structured-output"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "statement",
        "rationale",
        "owner",
        "sourceRefs",
        "scope",
        "formalization",
        "severity",
        "status",
        "targets",
        "verification",
        "changeControl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "exclude", "boundaries"],
          "properties": {
            "include": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "boundaries": {
              "type": "array",
              "items": {
                "enum": [
                  "code",
                  "api",
                  "rpc",
                  "database",
                  "queue",
                  "generated-code",
                  "deployment",
                  "evaluation"
                ]
              }
            }
          }
        },
        "formalization": {
          "enum": ["deterministic", "procedural", "cognitive"]
        },
        "severity": {
          "enum": ["info", "warn", "error"]
        },
        "status": {
          "enum": ["proposed", "active", "disabled"]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "examples": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "valid": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "invalid": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "changeControl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approvalRequired", "migrationRequired"],
          "properties": {
            "approvalRequired": {
              "type": "boolean"
            },
            "migrationRequired": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adapter"],
      "properties": {
        "kind": {
          "enum": [
            "agent-instruction",
            "formatter",
            "linter",
            "type-checker",
            "schema-validator",
            "contract-test",
            "git-hook",
            "ci",
            "repository-setting",
            "custom-command",
            "evaluation"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "configPath": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "passCriteria"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "passCriteria": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  }
}
