{
  "$schema": "../docs/api/eval-contract-v1.schema.json",
  "schemaVersion": "1.1",
  "suites": [
    {
      "id": "npm-release-worktree-policy",
      "kind": "capability",
      "owner": "zhichao",
      "description": "The distributed worktree Skill forbids dedicated npm release worktrees while preserving normal development worktrees.",
      "command": ["node", "evals/run_npm_release_policy.mjs"],
      "runnerSources": ["evals/run_npm_release_policy.mjs"],
      "tasks": ["evals/tasks/npm-release-worktree.jsonl"],
      "traceability": [
        {
          "requirementId": "PRD-REL-001",
          "ruleIds": ["npm-release-primary-checkout"]
        },
        {
          "requirementId": "PRD-REL-002",
          "ruleIds": ["npm-release-no-linked-worktree"]
        },
        {
          "requirementId": "PRD-REL-003",
          "ruleIds": ["npm-release-fail-closed"]
        },
        {
          "requirementId": "PRD-REL-004",
          "ruleIds": ["development-worktrees-preserved"]
        }
      ],
      "baseline": {
        "origin": "pre-implementation",
        "score": 0,
        "trials": 1,
        "evidence": "evals/baselines/npm-release-worktree-pre-implementation.json"
      },
      "target": {
        "metric": "pass-all-trials",
        "threshold": 1,
        "trials": 1
      },
      "graders": [
        {
          "id": "policy-text-check",
          "kind": "code",
          "role": "gate"
        },
        {
          "id": "agent-behavior-review",
          "kind": "model",
          "role": "guidance"
        }
      ],
      "negativeControl": {
        "command": ["node", "evals/run_npm_release_policy.mjs", "evals/fixtures/known-bad-npm-release-policy.md"],
        "fixture": "evals/fixtures/known-bad-npm-release-policy.md",
        "expectedExitCode": 1
      }
    },
    {
